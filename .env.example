# Neon PostgreSQL. `neon env pull` эсвэл `neon deploy` автоматаар бөглөнө.
# Гараар бол Neon console → Connect хэсгээс хоёр URL-ийг хуулна.
# Апп-ын query (pooled, хост нэрэнд -pooler):
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DBNAME?sslmode=require"
# Migration (шууд холболт, -pooler-гүй):
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
